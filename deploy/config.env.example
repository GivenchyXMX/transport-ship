# 复制为 deploy/config.env 后修改。反向代理在同机时可设 HOST=127.0.0.1。
PORT="${PORT:-8787}"
HOST="${HOST:-0.0.0.0}"
# 正式部署请配置 HTTPS 域名，并让反向代理将 /api/auth/* 和 /ws 转发到本服务。
PUBLIC_ORIGIN="${PUBLIC_ORIGIN:-}"
# 离线邮件邀请链接有效期，单位分钟，默认 10。
INVITE_TTL_MINUTES="${INVITE_TTL_MINUTES:-10}"
# 私聊记录保留时长，单位分钟，默认 43200（30 天）。
PRIVATE_MESSAGE_RETENTION_MINUTES="${PRIVATE_MESSAGE_RETENTION_MINUTES:-43200}"
# 邮箱注册和找回密码必填。SMTP_PASS 通常是邮箱服务商提供的授权码。
SMTP_HOST="${SMTP_HOST:-}"
SMTP_PORT="${SMTP_PORT:-465}"
SMTP_USER="${SMTP_USER:-}"
SMTP_PASS="${SMTP_PASS:-}"
SMTP_FROM="${SMTP_FROM:-}"
# 可选：限制新注册邮箱的域名，例如 @dtstack.com；留空不限制。
REGISTER_EMAIL_SUFFIX="${REGISTER_EMAIL_SUFFIX:-}"
# 可选，默认 .runtime/accounts.sqlite
AUTH_DB_PATH="${AUTH_DB_PATH:-}"
# 军衔经验发放默认开启；如需暂停新比赛的发放，可设为 0。
RANK_XP_ENABLED="${RANK_XP_ENABLED:-1}"
